# MODELO DE REFERÊNCIA PARA VERCEL.
# Não crie um único conjunto compartilhado entre Preview e Production.
# PREVIEW: APP_ENV=homolog + Firebase HML.
# PRODUCTION: APP_ENV=production + Firebase PROD.
USE_FIREBASE_EMULATORS=false
APP_ENV=homolog|production
FIREBASE_PROJECT_ID=<firebase-project-id-do-ambiente>
FIREBASE_API_KEY=<firebase-web-api-key-publica>
FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
FIREBASE_DATABASE_URL=https://<project>-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<id>
FIREBASE_APP_ID=<app-id>
# SERVER ONLY / SENSITIVE
FIREBASE_SERVICE_ACCOUNT_B64=<base64-do-json-da-service-account-do-mesmo-project-id>
LOGIN_RATE_LIMIT_SECRET=<segredo-aleatorio-32+-caracteres>
# OPCIONAL — Lançamento rápido: interpretação da fala por IA (Claude). Sem a chave,
# o celular usa o interpretador local (gratuito). Custo cobrado pela Anthropic na conta da empresa.
ANTHROPIC_API_KEY=
# OPCIONAL — modelo da IA (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=
