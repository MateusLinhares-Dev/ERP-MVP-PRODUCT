# PRODUÇÃO = Vercel Production + Firebase real do cliente.
# Arquivo apenas para preflight local. Valores reais devem ir para Environment Variables > Production na Vercel.
APP_ENV=production
USE_FIREBASE_EMULATORS=false
FIREBASE_PROJECT_ID=<firebase-prod-project-id>
FIREBASE_API_KEY=<firebase-web-api-key-publica-prod>
FIREBASE_AUTH_DOMAIN=<firebase-prod-project-id>.firebaseapp.com
FIREBASE_DATABASE_URL=https://<firebase-prod-project-id>-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=<firebase-prod-project-id>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<id-prod>
FIREBASE_APP_ID=<app-id-prod>
# SERVER ONLY — nunca enviar para public/dist
FIREBASE_SERVICE_ACCOUNT_B64=<service-account-prod-em-base64>
# SERVER ONLY — use 32+ caracteres aleatórios e diferente de HML
LOGIN_RATE_LIMIT_SECRET=<segredo-prod-com-32-ou-mais-caracteres>
