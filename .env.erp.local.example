# LOCAL + FIREBASE EMULATORS (não use projeto real aqui)
APP_ENV=local
USE_FIREBASE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-manuela-erp
FIREBASE_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-manuela-erp.firebaseapp.com
FIREBASE_DATABASE_URL=https://demo-manuela-erp.firebaseio.com
FIREBASE_STORAGE_BUCKET=demo-manuela-erp.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:local
FIREBASE_EMULATOR_HOST=127.0.0.1
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_DATABASE_EMULATOR_PORT=9000
FIREBASE_STORAGE_EMULATOR_PORT=9199
LOGIN_RATE_LIMIT_SECRET=local-only-change-this-value
LOCAL_DEV_PASSWORD_BASE=troque-este-prefixo-local
