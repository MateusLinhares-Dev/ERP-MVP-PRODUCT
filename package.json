{
  "name": "manuela-metais-erp-clean",
  "version": "1.0.30",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "emulators": "node scripts/emulators.mjs",
    "seed:emulator": "node scripts/prepare-local-env.mjs && node --import tsx --env-file=.env.erp.local scripts/seed-emulator.mjs",
    "dev:vercel": "node scripts/prepare-local-env.mjs && node scripts/vercel-dev.mjs",
    "dev": "node scripts/prepare-local-env.mjs && concurrently -k -n FIREBASE,APP \"npm:emulators\" \"wait-on http://127.0.0.1:4000 && npm run seed:emulator && npm run dev:vercel\"",
    "test": "node --import tsx --test test/*.test.js",
    "smoke:local": "node scripts/prepare-local-env.mjs && node --env-file=.env.erp.local scripts/smoke-local.mjs",
    "dev:static": "node scripts/static-dev.mjs",
    "check:demo": "npm test && npm run build",
    "prepare:env": "node scripts/prepare-local-env.mjs",
    "check:release": "npm run check && node scripts/release-security-check.mjs && node scripts/verify-deployment-artifacts.mjs",
    "preflight:hml": "node scripts/preflight-env.mjs hml .env.hml",
    "preflight:prod": "node scripts/preflight-env.mjs prod .env.production",
    "deploy:rules:hml": "node scripts/deploy-rules.mjs hml",
    "deploy:rules:prod": "node scripts/deploy-rules.mjs prod",
    "diagnose:emulator": "node scripts/prepare-local-env.mjs && node --env-file=.env.erp.local scripts/diagnose-emulator.mjs",
    "verify:deploy": "node scripts/verify-deployment-artifacts.mjs",
    "encode:service-account": "node scripts/service-account-to-base64.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f erp",
    "audit:access": "node scripts/access-inventory.mjs",
    "audit:purchases": "node scripts/audit-purchase-sync.mjs",
    "provision:engineer": "node --import tsx scripts/provision-engineer.mjs",
    "generate:rules:candidate": "node scripts/generate-granular-database-rules.mjs",
    "audit:security:strict": "ERP_SECURITY_STRICT=1 node scripts/release-security-check.mjs",
    "audit:payment-lock": "node scripts/audit-payment-lock.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint --no-error-on-unmatched-pattern server api web vite.config.ts",
    "format": "prettier --write \"server/**/*.ts\" \"api/**/*.ts\" \"web/**/*.{ts,tsx,css,html}\" vite.config.ts",
    "format:check": "prettier --check \"server/**/*.ts\" \"api/**/*.ts\" \"web/**/*.{ts,tsx,css,html}\" vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.1.3",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^9.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "^14.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vercel": "^48.0.0",
    "vite": "8.3.5",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
