rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function authorized() {
      return request.auth != null && request.auth.token.erpAccess == true;
    }
    function validBusinessFile() {
      return request.resource.size <= 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/octet-stream');
    }

    match /erp-files/funcDocs/{allPaths=**} {
      allow read: if authorized() && request.auth.token.canEmployeeDocs == true;
      allow create, update: if authorized() && request.auth.token.canEmployeeDocs == true && validBusinessFile();
      allow delete: if authorized() && request.auth.token.canEmployeeDocs == true;
    }

    match /erp-files/empresaDocs/{allPaths=**} {
      allow read: if authorized() && request.auth.token.canBusinessDocs == true;
      allow create, update: if authorized() && request.auth.token.canBusinessDocs == true && validBusinessFile();
      allow delete: if authorized() && request.auth.token.canBusinessDocs == true;
    }

    match /erp-files/frotaDocs/{allPaths=**} {
      allow read: if authorized() && request.auth.token.canFleetDocs == true;
      allow create, update: if authorized() && request.auth.token.canFleetDocs == true && validBusinessFile();
      allow delete: if authorized() && request.auth.token.canFleetDocs == true;
    }

    // Qualquer caminho fora dos três namespaces gerenciados é negado por padrão.
  }
}
