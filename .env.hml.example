# HML = Vercel Preview + Firebase EXCLUSIVO de homologação.
# Arquivo apenas para preflight local. Valores reais devem ir para Environment Variables > Preview na Vercel.
APP_ENV=homolog
USE_FIREBASE_EMULATORS=false
FIREBASE_PROJECT_ID=<firebase-hml-project-id>
FIREBASE_API_KEY=<firebase-web-api-key-publica-hml>
FIREBASE_AUTH_DOMAIN=<firebase-hml-project-id>.firebaseapp.com
FIREBASE_DATABASE_URL=https://<firebase-hml-project-id>-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=<firebase-hml-project-id>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<id-hml>
FIREBASE_APP_ID=<app-id-hml>
# SERVER ONLY — nunca enviar para public/dist
FIREBASE_SERVICE_ACCOUNT_B64=<service-account-hml-em-base64>
# SERVER ONLY — use 32+ caracteres aleatórios e diferente de PROD
LOGIN_RATE_LIMIT_SECRET=<segredo-hml-com-32-ou-mais-caracteres>
